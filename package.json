{
  "name": "builders-sodax-mcp-server",
  "version": "1.6.0",
  "description": "SODAX MCP server for developers - live API data and integration support",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "pnpm exec tsc && cp -r src/public dist/",
    "check:drift": "tsx --env-file-if-exists=.env src/scripts/checkDrift.ts",
    "check:docs": "tsx --env-file-if-exists=.env src/scripts/checkDocs.ts",
    "checkTs": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "e2e:canary": "tsx scripts/e2e/swapCanary.ts",
    "prepare": "husky",
    "clean": "rm -rf dist"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@scure/bip39": "1.6.0",
    "@sodax/sdk": "2.2.0",
    "@sodax/types": "2.2.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "posthog-node": "^5.24.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.8",
    "@vitest/coverage-v8": "^3.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "2.57.4",
    "vitest": "^3.2.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "ajv@<8.18.0": ">=8.18.0",
      "qs@>=6.7.0 <6.15.2": ">=6.15.2",
      "hono@<4.12.21": ">=4.12.21",
      "@hono/node-server@<1.19.14": "^1.19.14",
      "path-to-regexp@<0.1.13": "~0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.2": "^8.4.2",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "vite@<6.4.2": "^6.4.2",
      "@0no-co/graphqlsp@1.18.0": "1.17.5",
      "@mysten/bcs@2.1.3": "2.1.2",
      "bitcoinjs-lib@6.1.9": "6.1.8",
      "core-js-pure@3.51.0": "3.50.0",
      "core-js@3.51.0": "3.50.0",
      "follow-redirects@1.16.2": "1.16.1",
      "parse-asn1@5.1.10": "5.1.9",
      "viem@2.57.11": "2.57.4",
      "@mysten/utils@0.4.2": "0.4.1",
      "axios@>=1.0.0 <1.20.0": "1.20.0",
      "ws@>=8.0.0 <8.21.0": "8.21.3",
      "bn.js@>=5.0.0 <5.2.3": "5.2.5"
    }
  }
}
