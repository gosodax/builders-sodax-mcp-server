{
  "name": "builders-sodax-mcp-server",
  "version": "1.6.0",
  "description": "SODAX MCP server for developers - live API data and integration support",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "pnpm exec tsc && cp -r src/public dist/",
    "check:drift": "tsx --env-file-if-exists=.env src/scripts/checkDrift.ts",
    "checkTs": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepare": "husky",
    "clean": "rm -rf dist"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "posthog-node": "^5.24.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.8",
    "@vitest/coverage-v8": "^3.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "ajv@<8.18.0": ">=8.18.0",
      "qs@>=6.7.0 <6.15.2": ">=6.15.2",
      "hono@<4.12.21": ">=4.12.21",
      "@hono/node-server@<1.19.14": "^1.19.14",
      "path-to-regexp@<0.1.13": "~0.1.13",
      "path-to-regexp@>=8.0.0 <8.4.2": "^8.4.2",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "vite@<6.4.2": "^6.4.2"
    }
  }
}
