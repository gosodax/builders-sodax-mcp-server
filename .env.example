# PostHog Analytics (optional — tracking is silently skipped when unset)
# Get your API key at: https://eu.posthog.com → Settings → Project API Key
POSTHOG_API_KEY=
# Identifiers used to tag PostHog events. Leave blank to use the
# built-in defaults from src/services/analytics.ts. Override only if
# you're running your own PostHog project against this server.
POSTHOG_SERVER_NAME=
POSTHOG_DISTINCT_ID=
# Secret key for the per-client id (an HMAC of the client IP). Set a long random
# value in production, e.g. `openssl rand -hex 32`; changing it resets the ids.
POSTHOG_CLIENT_ID_SECRET=

# Server configuration
PORT=3000
# TRANSPORT=http

# SODAX API host: production (default) or canary. The relay always uses production.
# SODAX_ENV=production
# stdio only: API key forwarded to the SODAX API. Over HTTP each client sends x-api-key.
# SODAX_API_KEY=
# stdio only: tool profile (builder, swap or all). Over HTTP each client picks with ?profile=.
# MCP_PROFILE=all
# stdio only: partner fee on swap quotes, both or neither (EVM address, 1-100 bps). Over HTTP each client sets its own.
# SODAX_PARTNER_FEE_ADDRESS=
# SODAX_PARTNER_FEE_BPS=

# Kill switch for the swap tools: true (default) or false.
# SODAX_SWAP_TOOLS_ENABLED=true
# A quote worth more than this many USD warns the agent to confirm the amount (it never blocks). Default 10000.
# SODAX_SWAP_USD_WARN=10000
# RPC overrides for the swap tools, in the SODAX backend's format (its value works as is): JSON keyed by chain key,
# in the SDK's field names (Sui: grpc_url; Stellar: horizonRpcUrl, sorobanRpcUrl), https:// only, single-quoted here.
# A chain or field left out keeps the SDK's public default; set Polygon, Ethereum and Hedera in production, whose
# defaults are unreliable. Sonic's also carries the hub reads. Paid URLs embed a key: keep the value secret.
# RPC_CONFIG='{"sonic":{"rpcUrl":"https://…"},"ethereum":{"rpcUrl":"https://…"},"0x89.polygon":{"rpcUrl":"https://…"}}'

# Unified logging (OTLP). true ships every log record to the SODAX log gateway as well as stderr; then the next three are
# required. The token is a secret: deployment env only. DEPLOYMENT_ENV is prod, canary, staging or dev.
# OTEL_LOGS_ENABLED=false
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_LOGS_TOKEN=
# DEPLOYMENT_ENV=
# ORIGIN=
# The running commit, the records' service.version; the Docker image sets it from Coolify's SOURCE_COMMIT.
# GIT_SHA=

# Log verbosity. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Discord webhook for runtime alerts (optional — empty/unset = silent):
# server status (start/stop), significant errors, and API-drift summaries.
# Set on the PROD deployment; leave blank locally and on staging to stay quiet.
DISCORD_WEBHOOK_URL=
