# PostHog Analytics (optional — tracking is silently skipped when unset)
# Get your API key at: https://eu.posthog.com → Settings → Project API Key
POSTHOG_API_KEY=
# Identifiers used to tag PostHog events. Leave blank to use the
# built-in defaults from src/services/analytics.ts. Override only if
# you're running your own PostHog project against this server.
POSTHOG_SERVER_NAME=
POSTHOG_DISTINCT_ID=

# Server configuration
PORT=3000
# TRANSPORT=http

# SODAX API host: production (default) or canary. The relay always uses production.
# SODAX_ENV=production
# stdio only: API key forwarded to the SODAX API. Over HTTP each client sends x-api-key.
# SODAX_API_KEY=
# stdio only: tool profile (builder, swap or all). Over HTTP each client picks with ?profile=.
# MCP_PROFILE=all
# stdio only: partner fee on swap quotes, both or neither (EVM address, 1-100 bps). Over HTTP each client sets its own.
# SODAX_PARTNER_FEE_ADDRESS=
# SODAX_PARTNER_FEE_BPS=

# Rollout switch for the swap tools: true or false (default).
# SODAX_SWAP_TOOLS_ENABLED=false

# Log verbosity. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Discord webhook for runtime alerts (optional — empty/unset = silent):
# server status (start/stop), significant errors, and API-drift summaries.
# Set on the PROD deployment; leave blank locally and on staging to stay quiet.
DISCORD_WEBHOOK_URL=
